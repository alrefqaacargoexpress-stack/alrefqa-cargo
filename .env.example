# Development template only. Never copy production credentials here.
NODE_ENV=development
PORT=3000
# Use a separate Neon development database; never place the production URL here.
NEON_DATABASE_URL=postgresql://APP_USER:CHANGE_ME@ep-example.us-east-2.aws.neon.tech/alrefqa_development?sslmode=require
OWNER_EMAIL=owner@example.com
MANUS_JWT_SECRET=replace_with_a_unique_random_secret_before_startup

# Optional hosting services: configure only for your own development environment.
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
OWNER_OPEN_ID=
